# MongoDB Configuration
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=geoakim
MONGO_USERNAME=geoakim_user
MONGO_PASSWORD=secure_password_123

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
SESSION_SECRET=change_me_to_a_long_random_string

# Active Directory (LDAP)
AD_MP_URL=
AD_MP_DOMAIN=
AD_MP_BASE_DN=dc=
AD_MP_USE_SSL=

# Security
MEETING_URL_ALLOWLIST=teams.microsoft.com
COLLECT_RATE_LIMIT=30

# IP Geolocation (deprecated - precise GPS only)
# IP_GEO_ENABLED=false
# IP_GEO_PROVIDER=ip-api

# Dozzle Configuration (optional)
DOZZLE_LEVEL=info
DOZZLE_TAILSIZE=300

# Production nginx (prod.yml)
NGINX_SERVER_NAME=localhost
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
