# MongoDB Configuration
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=geoakim
MONGO_USERNAME=geoakim_user
MONGO_PASSWORD=secure_password_123

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# IP Geolocation (approximate location fallback)
IP_GEO_ENABLED=true
IP_GEO_PROVIDER=ip-api

# Dozzle Configuration (optional)
DOZZLE_LEVEL=info
DOZZLE_TAILSIZE=300