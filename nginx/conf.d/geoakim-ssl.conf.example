# Copy to geoakim-ssl.conf and mount certs in nginx/certs/ to enable HTTPS.
# HTTP server should redirect: return 301 https://$host$request_uri;

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /api/r {
        limit_req zone=api_r burst=10 nodelay;
        proxy_pass http://geoakim_web;
        include /etc/nginx/snippets/proxy_params.conf;
    }

    location / {
        proxy_pass http://geoakim_web;
        include /etc/nginx/snippets/proxy_params.conf;
    }
}
